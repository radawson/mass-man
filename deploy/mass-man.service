[Unit]
Description=Mass Man body tracking
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torvaldsl
Group=torvaldsl
WorkingDirectory=/home/torvaldsl/mass-man
EnvironmentFile=/home/torvaldsl/mass-man/.env
Environment=NODE_ENV=production
# Use the newest nvm Node. Do not hardcode a version; nvm's default alias may
# point at an uninstalled version, which leaves `node`/`next` off PATH.
ExecStart=/bin/bash -c 'NODE=$(ls -1d /home/torvaldsl/.nvm/versions/node/v* | sort -V | tail -1)/bin/node; exec "$NODE" node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3004'
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
