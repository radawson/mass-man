# Database - Matches docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://massman:PASSword01!!@localhost:5433/massman?schema=public"

# NextAuth - Generate a secure secret for production!
# Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3004"
NEXTAUTH_SECRET="replace-with-generated-secret"

# Keycloak OIDC - leave unset to use credentials-only locally
# KEYCLOAK_ID="ptx-mass-man"
# KEYCLOAK_SECRET="client-secret-from-keycloak"
# KEYCLOAK_ISSUER="https://logon.partridgecrossing.org/realms/ptx"

# App
PORT=3004
NEXT_PUBLIC_APP_URL="http://localhost:3004"

# Optional default admin for seed / /api/init
DEFAULT_ADMIN_EMAIL="admin@massman.local"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
DEFAULT_ADMIN_NAME="System Administrator"
